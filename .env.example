# banco de dados
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=call_help
MYSQL_USER=callhelp
MYSQL_PASSWORD=callhelppass

# backend
DATABASE_URL=mysql+aiomysql://callhelp:callhelppass@db:3306/call_help
JWT_SECRET=muda-esse-segredo-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# seed de admin (criado no startup se não existir)
ADMIN_EMAIL=admin@escola.edu
ADMIN_PASSWORD=123456
DEFAULT_USER_PASSWORD=123456

# storage de anexos: local hoje, s3 reservado para o futuro
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# S3 (ainda não usado — interface já pronta no backend)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=

# frontend
# dev: URL direta do backend; docker: use /api (nginx faz o proxy)
VITE_API_URL=http://localhost:8000
